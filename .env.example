# Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# RapidAPI Key for LinkedIn job search API
# Get yours at https://rapidapi.com/rockapis-rockapis-default/api/linkedin-jobs-search/
RAPIDAPI_KEY=

# Allowed browser origins for the API (comma-separated).
# In production set this to your Netlify site URL(s).
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
