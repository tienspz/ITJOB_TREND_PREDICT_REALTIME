# Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# RapidAPI Key for LinkedIn job search API
# Get yours at https://rapidapi.com/rockapis-rockapis-default/api/linkedin-jobs-search/
RAPIDAPI_KEY=

# Allowed browser origins for the API (comma-separated).
# In production set this to your Netlify site URL(s).
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# SerpAPI key for the Google Jobs realtime provider (free tier: 100 searches/month)
# Register at https://serpapi.com -> paste key here and Google Jobs joins the
# provider chain automatically (freehire.dev -> RemoteOK -> Google Jobs -> cache).
SERPAPI_KEY=
